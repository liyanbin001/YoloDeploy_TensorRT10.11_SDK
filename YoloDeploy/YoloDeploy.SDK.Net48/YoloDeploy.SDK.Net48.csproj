<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <AssemblyName>YoloDeploy.SDK.Net48</AssemblyName>
    <RootNamespace>YoloDeploy.SDK</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="WindowsBase" />
    <Reference Include="PresentationCore" />
    <Reference Include="PresentationFramework" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <Target Name="CopyNativeDll" AfterTargets="Build">
    <PropertyGroup>
      <NativeDll>$(MSBuildProjectDirectory)\..\artifacts\native\$(Configuration)\YoloDeploy.Native.dll</NativeDll>
    </PropertyGroup>
    <Copy SourceFiles="$(NativeDll)"
          DestinationFolder="$(OutDir)"
          Condition="Exists('$(NativeDll)')" />
  </Target>
</Project>
